{
  "name": "hualuo-garden",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5416 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5416 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "assets": "node scripts/build-assets.mjs",
    "qa": "node scripts/browser-qa.mjs",
    "open": "node scripts/open-garden.mjs",
    "check:assets": "node scripts/validate-assets.mjs",
    "check:walkways": "node scripts/validate-walkways.mjs",
    "check:reading": "node --experimental-strip-types scripts/validate-reading-views.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "draco3d": "1.5.9",
    "meshoptimizer": "1.3.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
